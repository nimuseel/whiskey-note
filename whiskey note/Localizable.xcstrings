    },
    "\"%@\"" : {

    },
    "%@ %@" : {
      "comment" : "A text label with an emoji and the name of a flavor, followed by a horizontal bar that visually represents the intensity of the flavor. The emoji is followed by a space, then the flavor name, another space, and then a horizontal bar that is 5 segments long, each of which is filled to represent the intensity.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ %lld%%" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$lld%%"
          }
        }
      }
    },
    "%lld" : {
      "comment" : "A text view displaying the intensity level of a flavor. If the intensity is 0, it shows a dash (\"–\"). Otherwise, it shows the intensity as a number.",
